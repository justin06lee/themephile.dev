# Copy to .env.local. Every value here is server-only — none are NEXT_PUBLIC_,
# because with Turso the database credential is a real secret and the browser
# never talks to the database directly.
#
# The gallery degrades in two independent steps. Without the Turso pair,
# /themes says it isn't configured and everything else works. With Turso but
# without the GitHub pair, the gallery is fully readable and crawlable but
# can't take new themes — the sign-in button hides itself rather than failing.

# ── Database ──────────────────────────────────────────────────────────────
# turso db create themephile
# turso db show themephile --url
# turso db tokens create themephile
TURSO_DATABASE_URL=libsql://<database>-<org>.turso.io
TURSO_AUTH_TOKEN=

# ── Sign-in (optional) ────────────────────────────────────────────────────
# A GitHub OAuth App: https://github.com/settings/developers
# Authorization callback URL must be exactly <origin>/api/auth/callback
#   local:      http://localhost:3000/api/auth/callback
#   production: https://themephile.dev/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the session cookie. Any long random string; 32 bytes minimum.
#   openssl rand -base64 32
SESSION_SECRET=
