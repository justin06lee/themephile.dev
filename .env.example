# Copy to .env.local. Both values are safe to expose in the browser: every
# table is behind row-level security and column-level grants, so the
# publishable key can only do what an anonymous visitor is allowed to do.
#
# Find them at: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
